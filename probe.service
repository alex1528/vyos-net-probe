[Unit]
Description=出口分流探针服务 (probe_server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 探针服务安装目录（部署脚本会同步到此路径）
WorkingDirectory=/opt/vyos-net-probe
# 启动前引导：确保 nginx 站点软链存在且 nginx 运行（模拟 VyOS 托管，不依赖 service https）
# 前缀 '+' 让该命令以完整 root 权限运行，不受下方沙箱(ProtectSystem)限制，从而可管理 nginx
ExecStartPre=+/bin/bash /opt/vyos-net-probe/ensure_nginx.sh
ExecStart=/usr/bin/python3 /opt/vyos-net-probe/probe_server.py
Environment=PROBE_HOST=127.0.0.1
Environment=PROBE_PORT=8899
# L1 DNS 服务器（等价 dig <域名> @<IP>）：
#   auto = 依次取 PROBE_DNS_IFACES 网卡 IPv4（eth2→eth3），最后回退 127.0.0.1，探活择优
#   也可固定：PROBE_DNS=10.60.2.254  或多个：PROBE_DNS=10.60.2.254,10.60.3.254  或网卡名：PROBE_DNS=eth2
#   注：mihomo DNS 若只监听内网网卡 IP（非 127.0.0.1），旧值 127.0.0.1 会导致 L1 全部"无响应/超时"
Environment=PROBE_DNS=auto
Environment=PROBE_DNS_IFACES=eth2,eth3
# L4 归属地预期（v2.3，按出口通道）：CN | HK | CN,HK | !CN | any；未设置则 DIRECT=CN、代理=!CN
#   归属地只表示“线路在哪”，不一致默认仅提示；是否走错出口由“串线检测”(出口IP相同)判定
#   若 DIRECT 线路本身在香港，取消下一行注释即可消除提示
#Environment=PROBE_GEO_DIRECT=HK
# 归属地不一致也判失败（默认 0=仅提示）
Environment=PROBE_GEO_STRICT=0
# 软链自愈检查间隔(秒)，0=关闭；防 VyOS commit/升级覆盖后本站点软链失效
Environment=PROBE_SELF_HEAL_INTERVAL=300
# mihomo 配置文件路径（探针启动时自动检测出口模式：有HKPROXY→三出口/仅USPROXY→两出口）
Environment=MIHOMO_CONFIG_PATH=/etc/mihomo/config.yaml
Restart=on-failure
RestartSec=3
# 安全加固（主服务仅需读+网络，无需写系统；ExecStartPre 用 '+' 豁免以管理 nginx）
NoNewPrivileges=true
ProtectSystem=strict
# 主进程软链自愈需写 sites-enabled；探针历史写安装目录
ReadWritePaths=/opt/vyos-net-probe /etc/nginx/sites-enabled

[Install]
WantedBy=multi-user.target
